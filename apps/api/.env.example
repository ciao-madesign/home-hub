# Copia in .env e adatta ai tuoi valori. Tutte le variabili hanno un default
# ragionevole per lo sviluppo locale — vedi src/config.ts.
#
# L'Hub API gira sull'host (non in Docker — vedi docs/SPECIFICHE.md §2/§3
# per il perché, legato al modulo Gaming). In produzione sul Wyse, Jellyfin
# e Immich restano containerizzati ma esposti sull'host: raggiungibili via
# "localhost" da qui, non via nome del servizio Docker.

HUB_API_PORT=4000
HUB_API_HOST=0.0.0.0

# Percorso del database SQLite dell'Hub. In produzione, meglio un percorso
# assoluto dentro infra/data/ per tenerlo insieme al resto dei dati ai fini
# del backup, es. HUB_DB_PATH=/opt/home-hub/infra/data/hub/hub.sqlite
HUB_DB_PATH=./data/hub.sqlite

# Radice della libreria dati (struttura in docs/SPEC_V1.md §4). Il default
# relativo funziona in sviluppo (npm run dev, cwd = apps/api) e in
# produzione se il servizio systemd ha WorkingDirectory=.../apps/api (vedi
# infra/systemd/home-hub-api.service) — ma un percorso assoluto è più
# robusto in produzione, es. HUB_DATA_ROOT=/opt/home-hub/infra/data
HUB_DATA_ROOT=../../infra/data

HUB_DISK_CRITICAL_FREE_PERCENT=10

# Origini consentite (CORS) per il frontend. In produzione: l'origine da
# cui la Web App viene servita (nginx), es. http://hub.local o l'IP del Wyse.
HUB_CORS_ORIGINS=http://localhost:5173

# Backend multimediali (opzionali finché non integrati, vedi Fase 5)
# HUB_JELLYFIN_URL=http://localhost:8096/health
# HUB_IMMICH_URL=http://localhost:2283/api/server-info/ping

# Client Jellyfin (Film/Serie, §7). In produzione: http://localhost:8096
# (porta esposta dal container sull'host). Crea l'API key da Jellyfin:
# Dashboard → API Keys.
# HUB_JELLYFIN_BASE_URL=http://localhost:8096
# HUB_JELLYFIN_API_KEY=

# Client Immich (Foto/Video personali, §8). In produzione: http://localhost:2283
# (porta esposta dal container sull'host). Crea l'API key da Immich:
# Account Settings → API Keys.
# HUB_IMMICH_BASE_URL=http://localhost:2283
# HUB_IMMICH_API_KEY=

HUB_SESSION_TTL_LOCAL=2592000
HUB_SESSION_TTL_REMOTE=43200

# Download Manager (§12). yt-dlp deve essere nel PATH (pip install yt-dlp).
# Se installato con "pip install --user", systemd potrebbe non vedere
# ~/.local/bin: usa qui il percorso assoluto in quel caso, es.
# HUB_YTDLP_PATH=/home/homehub/.local/bin/yt-dlp
HUB_YTDLP_PATH=yt-dlp
HUB_DOWNLOAD_MAX_CONCURRENT=2
# Priorità minima rispetto a streaming/backup (§32): limite di banda
# globale sempre applicato, in KB/s. 0 = nessun limite.
HUB_DOWNLOAD_MAX_RATE_KBPS=8000

# Storage e Backup (§4/§5/§29). Senza HUB_BACKUP_ROOT il backup resta
# "non disponibile" (l'Hub continua a funzionare con un avviso, §5) — in
# produzione va impostato al mount point del secondo disco/partizione di
# backup, es. HUB_BACKUP_ROOT=/mnt/backup-disk/home-hub
# HUB_BACKUP_ROOT=
HUB_BACKUP_INTERVAL_HOURS=24
# Limite di banda per il backup (§32), stessa semplificazione statica già
# usata per i download. 0 = nessun limite.
HUB_BACKUP_MAX_RATE_KBPS=0
HUB_BACKUP_RECENT_MAX_AGE_HOURS=48

# SMART (§29): richiede smartmontools installato (apt install
# smartmontools) e, in produzione, che l'Hub API (utente "homehub") possa
# leggere i device — valutare eventuali permessi/regole udev sul Wyse.
HUB_SMARTCTL_PATH=smartctl
HUB_FINDMNT_PATH=findmnt

# Dischi aggiuntivi da monitorare oltre a dataRoot/backupRoot (§29), come
# JSON: [{"id":"esterno","label":"Disco esterno","path":"/mnt/esterno"}]
# HUB_EXTRA_DISKS_JSON=
