# Copia in .env e adatta ai tuoi valori. Tutte le variabili hanno un default
# ragionevole per lo sviluppo locale — vedi src/config.ts.

HUB_API_PORT=4000
HUB_API_HOST=0.0.0.0

# Percorso del database SQLite dell'Hub
HUB_DB_PATH=./data/hub.sqlite

# Radice della libreria dati (struttura in docs/SPEC_V1.md §4)
HUB_DATA_ROOT=../../infra/data

HUB_DISK_CRITICAL_FREE_PERCENT=10

# Origini consentite (CORS) per il frontend
HUB_CORS_ORIGINS=http://localhost:5173

# Backend multimediali (opzionali finché non integrati, vedi Fase 5)
# HUB_JELLYFIN_URL=http://localhost:8096/health
# HUB_IMMICH_URL=http://localhost:2283/api/server-info/ping

# Client Jellyfin (Film/Serie, §7). Crea l'API key da Jellyfin:
# Dashboard → API Keys.
# HUB_JELLYFIN_BASE_URL=http://localhost:8096
# HUB_JELLYFIN_API_KEY=

# Client Immich (Foto/Video personali, §8). Crea l'API key da Immich:
# Account Settings → API Keys.
# HUB_IMMICH_BASE_URL=http://localhost:2283
# HUB_IMMICH_API_KEY=

HUB_SESSION_TTL_LOCAL=2592000
HUB_SESSION_TTL_REMOTE=43200

# Download Manager (§12). yt-dlp deve essere nel PATH (già vero
# nell'immagine Docker; in locale: pip install yt-dlp).
HUB_YTDLP_PATH=yt-dlp
HUB_DOWNLOAD_MAX_CONCURRENT=2
# Priorità minima rispetto a streaming/backup (§32): limite di banda
# globale sempre applicato, in KB/s. 0 = nessun limite.
HUB_DOWNLOAD_MAX_RATE_KBPS=8000
