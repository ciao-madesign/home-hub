# Copia in .env e adatta ai tuoi valori. Tutte le variabili hanno un default
# ragionevole per lo sviluppo locale — vedi src/config.ts.
#
# L'Hub API gira sull'host (non in Docker — vedi docs/SPECIFICHE.md §2/§3
# per il perché, legato al modulo Gaming). In produzione sul Wyse, Jellyfin
# e Immich restano containerizzati ma esposti sull'host: raggiungibili via
# "localhost" da qui, non via nome del servizio Docker.

HUB_API_PORT=4000
HUB_API_HOST=0.0.0.0

# Percorso del database SQLite dell'Hub. In produzione, meglio un percorso
# assoluto dentro infra/data/ per tenerlo insieme al resto dei dati ai fini
# del backup, es. HUB_DB_PATH=/opt/home-hub/infra/data/hub/hub.sqlite
HUB_DB_PATH=./data/hub.sqlite

# Radice della libreria dati (struttura in docs/SPEC_V1.md §4). Il default
# relativo funziona in sviluppo (npm run dev, cwd = apps/api) e in
# produzione se il servizio systemd ha WorkingDirectory=.../apps/api (vedi
# infra/systemd/home-hub-api.service) — ma un percorso assoluto è più
# robusto in produzione, es. HUB_DATA_ROOT=/opt/home-hub/infra/data
HUB_DATA_ROOT=../../infra/data

HUB_DISK_CRITICAL_FREE_PERCENT=10

# Origini consentite (CORS) per il frontend. In produzione: l'origine da
# cui la Web App viene servita (nginx), es. http://hub.local o l'IP del Wyse.
HUB_CORS_ORIGINS=http://localhost:5173

# Backend multimediali (opzionali finché non integrati, vedi Fase 5)
# HUB_JELLYFIN_URL=http://localhost:8096/health
# HUB_IMMICH_URL=http://localhost:2283/api/server-info/ping

# Client Jellyfin (Film/Serie, §7). In produzione: http://localhost:8096
# (porta esposta dal container sull'host). Crea l'API key da Jellyfin:
# Dashboard → API Keys.
# HUB_JELLYFIN_BASE_URL=http://localhost:8096
# HUB_JELLYFIN_API_KEY=

# Client Immich (Foto/Video personali, §8). In produzione: http://localhost:2283
# (porta esposta dal container sull'host). Crea l'API key da Immich:
# Account Settings → API Keys.
# HUB_IMMICH_BASE_URL=http://localhost:2283
# HUB_IMMICH_API_KEY=

HUB_SESSION_TTL_LOCAL=2592000
HUB_SESSION_TTL_REMOTE=43200

# Download Manager (§12). yt-dlp deve essere nel PATH (pip install yt-dlp).
# Se installato con "pip install --user", systemd potrebbe non vedere
# ~/.local/bin: usa qui il percorso assoluto in quel caso, es.
# HUB_YTDLP_PATH=/home/homehub/.local/bin/yt-dlp
HUB_YTDLP_PATH=yt-dlp
HUB_DOWNLOAD_MAX_CONCURRENT=2
# Priorità minima rispetto a streaming/backup (§32): limite di banda
# globale sempre applicato, in KB/s. 0 = nessun limite.
HUB_DOWNLOAD_MAX_RATE_KBPS=8000
# Limite ridotto applicato quando c'è streaming Jellyfin attivo O un
# backup in corso (priorità dinamica, lib/priority.ts). 0 = disattiva la
# riduzione dinamica (resta sempre HUB_DOWNLOAD_MAX_RATE_KBPS).
HUB_DOWNLOAD_THROTTLED_RATE_KBPS=1000

# Storage e Backup (§4/§5/§29). Senza HUB_BACKUP_ROOT il backup resta
# "non disponibile" (l'Hub continua a funzionare con un avviso, §5) — in
# produzione va impostato al mount point del secondo disco/partizione di
# backup, es. HUB_BACKUP_ROOT=/mnt/backup-disk/home-hub
# HUB_BACKUP_ROOT=
HUB_BACKUP_INTERVAL_HOURS=24
# Limite di banda per il backup (§32). 0 = nessun limite.
HUB_BACKUP_MAX_RATE_KBPS=0
# Limite ridotto quando c'è streaming Jellyfin attivo (il backup NON cede
# priorità ai download, solo allo streaming — priorità "media", vedi
# lib/priority.ts). 0 = disattiva la riduzione dinamica.
HUB_BACKUP_THROTTLED_RATE_KBPS=1000
HUB_BACKUP_RECENT_MAX_AGE_HOURS=48

# SMART (§29): richiede smartmontools installato (apt install
# smartmontools) e, in produzione, che l'Hub API (utente "homehub") possa
# leggere i device — valutare eventuali permessi/regole udev sul Wyse.
HUB_SMARTCTL_PATH=smartctl
HUB_FINDMNT_PATH=findmnt

# Dischi aggiuntivi da monitorare oltre a dataRoot/backupRoot (§29), come
# JSON: [{"id":"esterno","label":"Disco esterno","path":"/mnt/esterno"}]
# Aggiungi "role":"data" per farlo partecipare anche alla libreria virtuale
# multi-disco del File Manager (§4, lib/storage/library.ts): i nuovi
# file/cartelle possono finire lì, scelto in base allo spazio libero. Senza
# "role" resta solo informativo (visibile in Storage, mai scelto per
# scrivere) — comportamento invariato per chi l'aveva già configurato
# prima di questa funzionalità.
# HUB_EXTRA_DISKS_JSON=[{"id":"esterno","label":"Disco esterno","path":"/mnt/esterno","role":"data"}]

# Rete e setup iniziale (§21/§28). HUB_WEB_PORT è la porta su cui nginx
# espone la Web App (deve coincidere con HUB_WEB_PORT in infra/.env) —
# l'Hub API la usa solo per costruire l'URL corretto da mostrare via
# mDNS/QR, non ci ascolta sopra.
HUB_WEB_PORT=80
HUB_MDNS_ENABLED=true
HUB_MDNS_HOSTNAME=home-hub

# Wi-Fi (§28): richiede NetworkManager (nmcli) sull'host.
HUB_NMCLI_PATH=nmcli

# DDNS (§23): provider di default DuckDNS (https://www.duckdns.org — gratuito,
# crea un account e un dominio tipo "mio-hub.duckdns.org", il token è nella
# dashboard). Senza HUB_DDNS_DOMAIN/HUB_DDNS_TOKEN il DDNS resta disattivato.
# HUB_DDNS_DOMAIN=mio-hub
# HUB_DDNS_TOKEN=
HUB_DDNS_BASE_URL=https://www.duckdns.org
HUB_DDNS_INTERVAL_MINUTES=15

# Stato Internet (§30): endpoint leggero solo per il controllo di
# raggiungibilità, non un servizio applicativo.
HUB_INTERNET_CHECK_URL=https://www.gstatic.com/generate_204
HUB_INTERNET_CHECK_TIMEOUT_MS=3000

# Riavvio automatico dei servizi interni (§31): richiede `docker` nel PATH
# e che l'utente di sistema dell'Hub API sia nel gruppo "docker"
# (sudo usermod -aG docker homehub). I nomi dei container devono
# corrispondere a quelli in infra/docker-compose.yml.
HUB_DOCKER_PATH=docker
HUB_JELLYFIN_CONTAINER=jellyfin
HUB_IMMICH_CONTAINER=immich-server
HUB_WATCHDOG_INTERVAL_SECONDS=60
HUB_WATCHDOG_FAILURES_BEFORE_RESTART=3
HUB_WATCHDOG_MAX_RESTART_ATTEMPTS=3

# Priorità di banda dinamica (§32, lib/priority.ts): ogni quanti secondi
# controllare se c'è una riproduzione Jellyfin attiva (GET /Sessions).
HUB_STREAMING_CHECK_INTERVAL_SECONDS=10

# Spegnimento sicuro da Web App (§34): richiede il permesso sudo mirato in
# infra/systemd/homehub-shutdown-sudoers (vedi README "Deploy").
HUB_SHUTDOWN_COMMAND=sudo
HUB_SHUTDOWN_ARGS_JSON=["/sbin/shutdown","-h","now"]

# Aggiornamenti Hub autorizzati dalla Web App (§33): richiede git nel
# PATH e il permesso sudo mirato in infra/systemd/homehub-update-sudoers
# (vedi README "Deploy") per il solo riavvio del servizio dopo il pull.
HUB_GIT_PATH=git
HUB_NPM_PATH=npm
HUB_UPDATE_BRANCH=main
HUB_UPDATE_RESTART_COMMAND=sudo
HUB_UPDATE_RESTART_ARGS_JSON=["systemctl","restart","home-hub-api"]

# VPN personale WireGuard (§2 in docs/SPECIFICHE.md — ultima funzione della
# Fase 9, disattivata di default). Richiede `wireguard-tools` (pacchetto
# omonimo su Debian/Ubuntu), il modulo kernel WireGuard e che il processo
# dell'Hub API abbia CAP_NET_ADMIN/CAP_NET_RAW — vedi
# infra/systemd/home-hub-api.service e README "Deploy" prima di attivarla.
HUB_VPN_ENABLED=false
HUB_VPN_INTERFACE=wg0
# Cartella dove l'Hub tiene wg0.conf e la propria chiave privata (mai
# quelle dei client, generate e restano sui loro dispositivi).
HUB_VPN_CONFIG_DIR=./data/vpn
HUB_VPN_LISTEN_PORT=51820
# Subnet dedicata al VPN: deve essere diversa dalla LAN di casa.
HUB_VPN_SUBNET_CIDR=10.90.0.0/24
# Interfaccia con uscita Internet sul Wyse, per il NAT del profilo
# "tunnel completo" — verificare con `ip route` sull'hardware reale.
HUB_VPN_WAN_INTERFACE=eth0
# Indirizzo pubblico mostrato ai client come Endpoint. Se non impostato e
# il DDNS (§23) è configurato, riusa lo stesso dominio.
# HUB_VPN_ENDPOINT_HOST=
