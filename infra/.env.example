# Copia in infra/.env e adatta ai tuoi valori.
#
# Nota: da quando l'Hub API gira sull'host e non in Docker (vedi
# docs/SPECIFICHE.md §2/§3), le variabili dell'Hub API (CORS, API key
# Jellyfin/Immich, limiti del Download Manager, ecc.) si configurano in
# apps/api/.env, non qui — qui restano solo le variabili che il compose
# di web/Jellyfin/Immich usa davvero.

# Porta su cui esporre la Web App (nginx)
HUB_WEB_PORT=80

# Password del database Postgres di Immich — cambiala rispetto al default
HUB_IMMICH_DB_PASSWORD=immich
