# Copia in infra/.env e adatta ai tuoi valori.

# Porta su cui esporre la Web App (nginx)
HUB_WEB_PORT=80

# Origini consentite per le chiamate all'API (aggiungi qui hostname .local,
# dominio DDNS, ecc. quando configurati — vedi §21-24)
HUB_CORS_ORIGINS=http://localhost,http://hub.local

# API key Jellyfin (Dashboard → API Keys, dopo il primo avvio di Jellyfin)
HUB_JELLYFIN_API_KEY=
