# Copia in infra/.env e adatta ai tuoi valori.
#
# Nota: da quando l'Hub API gira sull'host e non in Docker (vedi
# docs/SPECIFICHE.md §2/§3), le variabili dell'Hub API (CORS, API key
# Jellyfin/Immich, limiti del Download Manager, ecc.) si configurano in
# apps/api/.env, non qui — qui restano solo le variabili che il compose
# di web/Jellyfin/Immich usa davvero.

# Porta su cui esporre la Web App (nginx)
HUB_WEB_PORT=80

# Password del database Postgres di Immich — cambiala rispetto al default
HUB_IMMICH_DB_PASSWORD=immich

# AdGuard Home (fuori roadmap, blocco pubblicità/tracker a livello DNS
# per tutta la rete di casa) — porta del pannello di amministrazione,
# diversa da 80/443 già usate da web/Caddy. La porta 53 (DNS vero e
# proprio) non è configurabile qui: deve restare la 53 standard perché è
# quella che i dispositivi si aspettano, vedi commento in
# docker-compose.yml se risulta già occupata da systemd-resolved.
HUB_ADGUARD_ADMIN_PORT=3001

# Accesso remoto HTTPS (§22-24), servizio "caddy" opzionale — attivo solo
# con `docker compose --profile remote-https up -d`. Il dominio pubblico
# a cui punta (es. il DDNS configurato in apps/api/.env) e l'email per
# gli avvisi di scadenza certificato di Let's Encrypt. Richiede aprire la
# porta 443 sul router (non funziona con CGNAT — vedi il tunnel sotto).
# HUB_PUBLIC_DOMAIN=mio-hub.duckdns.org
# HUB_ACME_EMAIL=tuo@indirizzo.it

# Tunnel di fallback GRATUITO (§23), servizi "cloudflared"+"caddy-tunnel"
# opzionali — attivi solo con `docker compose --profile remote-tunnel up -d`.
# Alternativa a HUB_PUBLIC_DOMAIN/porta 443 per chi non può aprire porte
# sul router (es. CGNAT): nessuna porta da inoltrare, l'Hub si collega lui
# a Cloudflare. Token del tunnel da
# https://one.dash.cloudflare.com (Zero Trust → Networks → Tunnels →
# "Create a tunnel") — vedi README "Deploy" per la procedura completa.
# HUB_CLOUDFLARE_TUNNEL_TOKEN=
